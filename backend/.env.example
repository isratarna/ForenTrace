# ---- Chatbot ----
MONGODB_URI=
MONGODB_DB=forentrace_chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
CHATBOT_SCORE_THRESHOLD=0.70
# Optional: max wait for one Gemini call before switching model (ms, default 15000)
GEMINI_TIMEOUT_MS=15000
# Optional: minimal | low | medium | high. Less thinking = faster answer. Leave empty for the model default.
GEMINI_THINKING_LEVEL=